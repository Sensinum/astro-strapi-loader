{
  "name": "@sensinum/astro-strapi-loader",
  "version": "1.5.0",
  "description": "Astro loader for Strapi CMS",
  "keywords": [
    "astro",
    "strapi",
    "cms",
    "loader",
    "content",
    "astro-component",
    "astro-loader",
    "content-layer",
    "astro-integration"
  ],
  "license": "MIT",
  "author": "Sensinum <hello@sensinum.com>",
  "contributors": [
    "Mateusz Ziarko <mziarko@virtuslab.com> (https://github.com/cyp3rius)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sensinum/astro-strapi-loader.git"
  },
  "bugs": {
    "url": "https://github.com/Sensinum/astro-strapi-loader/issues"
  },
  "homepage": "https://github.com/Sensinum/astro-strapi-loader#readme",
  "engines": {
    "node": ">=22.0.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "packageManager": "yarn@4.13.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "yarn clean && tsc",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "coverage": "jest --ci --coverage --runInBand",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "tsc --noEmit",
    "prepare": "husky install"
  },
  "dependencies": {
    "astro": "7.4.5",
    "qs": "^6.15.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/qs": "^6.9.14",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0",
    "zod": "^4.6.6"
  },
  "resolutions": {
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  }
}
